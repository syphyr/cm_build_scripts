docker exec open-webui ls -lh /app/backend/data/uploads/

docker exec open-webui python3 -c '
import os, sqlite3

conn = sqlite3.connect("/app/backend/data/webui.db")
cur = conn.cursor()

uploads_dir = "/app/backend/data/uploads"
removed, freed = 0, 0
for fname in os.listdir(uploads_dir):
    if fname.endswith("_generated-image.png"):
        fpath = os.path.join(uploads_dir, fname)
        if os.path.isfile(fpath):
            freed += os.path.getsize(fpath)
            os.remove(fpath)
            fid = fname.split("_")[0]
            cur.execute("DELETE FROM file WHERE id = ?", (fid,))
            removed += 1

conn.commit()
print(f"Removed {removed} generated images ({freed / (1024*1024):.1f} MB freed).")
'


